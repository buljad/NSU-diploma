  | 'PONG';

export type ClientMessageType =
  | 'CONNECT'
  | 'DISCONNECT'
  | 'CALIBRATE_ZERO'
  | 'CONFIGURE_AXES'
  | 'LIST_PORTS'
  | 'PING';

export interface PortInfo {
  path: string;
  manufacturer?: string;
  vendorId?: string;
  productId?: string;
}

export interface WSMessage<T = unknown> {
  type: string;
  payload?: T;
  timestamp?: number;
