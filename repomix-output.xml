		durationMs: 0
	},

	[STAGE_2]: {
		stage: STAGE_2,
		maxActiveBalls: 4,
		ballSpeedMin: 75,
		ballSpeedMax: 130,
		spawnIntervalMs: 2200,
		colorCount: 5,
		targetColorFixed: false,
		colorChangeIntervalMs: 17_000,
		dwellTimeMs: 700,
		hasFastBalls: false,
		fastBallRatio: 0,
		fastBallSpeedMultiplier: 1,
		useSymbols: false,
		catchesToAdvance: 12,
		durationMs: 0
	},

	[STAGE_3]: {
