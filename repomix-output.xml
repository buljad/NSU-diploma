		maxActiveBalls: 5,
		ballSpeedMin: 90,
		ballSpeedMax: 160,
		spawnIntervalMs: 1900,
		colorCount: 4,
		targetColorFixed: true,
		colorChangeIntervalMs: 0,
		dwellTimeMs: 600,
		hasFastBalls: true,
		fastBallRatio: 0.3,
		fastBallSpeedMultiplier: 2.2,
		useSymbols: false,
		catchesToAdvance: 12,
		durationMs: 0
	},

	[STAGE_FINAL]: {
		stage: STAGE_FINAL,
		maxActiveBalls: 7,
		ballSpeedMin: 110,
		ballSpeedMax: 190,
		spawnIntervalMs: 1300,
		colorCount: 6,
		targetColorFixed: false,
		colorChangeIntervalMs: 12_000,
